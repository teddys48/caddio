# Caddio Environment Variables Example

# Application Environment (development, production)
APP_ENV=development

# Application Port
PORT=8080

# SQLite Database File Path
DATABASE_PATH=./caddy-manager.db

# Caddy Admin API URL (Internal Docker network or localhost)
# Example Docker Compose: http://caddy:2019
# Example Local Dev: http://localhost:2019
CADDY_ADMIN_URL=http://localhost:2019

# Path to Host Caddy Executable Binary
# Default: /usr/bin/caddy
CADDY_BINARY_PATH=/usr/bin/caddy

# Secret key for session cookie encryption / signing
# REQUIRED in production mode (APP_ENV=production, minimum 32 characters)
# In development mode, auto-generated if omitted
SESSION_SECRET=a_very_secure_random_production_secret_32_chars_min
